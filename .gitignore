!models/final_model/
models/final_model/*
!models/final_model/config.json
!models/final_model/train.log
!models/final_model/metrics.jsonl
!models/final_model/physical_model_metadata.json
logs/
plots/
figures/
reports/
tuning_results/
test/models/

